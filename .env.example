# Copy to .env.local for development, and set the same keys in your host's
# environment (Vercel → Settings → Environment Variables) for production.

# ---- Required ----------------------------------------------------------

# Signs the admin session cookie. Admin login throws without it.
# Generate one with:  openssl rand -base64 32
SESSION_SECRET=

# Admin panel password. Login refuses with ?error=config if unset.
ADMIN_PASSWORD=

# ---- Required in production, optional locally --------------------------

# Postgres (Neon) connection string. Without it the app falls back to the
# data/db.json file store, which works locally but NOT on a serverless host:
# the filesystem there is read-only and per-request, so every enquiry,
# booking and CMS edit would be lost.
DATABASE_URL=

# ---- Optional ----------------------------------------------------------

# Admin panel username. Defaults to "admin" when unset.
ADMIN_USERNAME=

# Resend API key. Without it the site still saves enquiries and bookings,
# it just sends no email. See the note in README about the sender domain.
RESEND_API_KEY=

# Sender address for all outgoing mail. MUST be on a Resend-verified domain —
# the shared onboarding@resend.dev sender only delivers to the Resend account
# owner, so visitor-facing mail silently fails. Defaults to
# "My Skill Counsellor <noreply@myskillcounsellor.com>" when unset.
MAIL_FROM=

# Comma-separated fallback for who receives new-lead notifications. The admin
# panel (Notifications tab) overrides this and is the preferred place to edit.
ADMIN_NOTIFY_EMAILS=

# ---- Web Push (admin panel notifications) ------------------------------
# Generate a pair with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# Without these the admin panel still works, it just sends no push alerts.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
